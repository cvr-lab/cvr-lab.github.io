# Configuración de scripts/deploy-ugr.sh
#
# Cópialo FUERA del repositorio y protégelo (contiene datos de acceso):
#   mkdir -p ~/.config
#   cp scripts/deploy-ugr.env.example ~/.config/cvr-deploy.env
#   chmod 600 ~/.config/cvr-deploy.env
# NUNCA lo subas a GitHub.

# Repositorio del que se construye la web (rama main). Si es público no hace falta usuario.
REPO_URL="https://github.com/cvr-lab/cvr-lab.github.io.git"
BRANCH="main"

# Dirección final de la web, con la barra del final. Si cuelga de una subcarpeta,
# inclúyela (p. ej. https://www.ugr.es/~cvrlab/).
SITE_URL=""

# Servidor FTPS de la UGR
FTPS_HOST=""
FTPS_PORT=""
FTPS_USER=""

# Autenticación: lo recomendable es una clave SSH propia para esto...
# FTPS_KEY="$HOME/.ssh/id_cvr_deploy"
# ...y solo si no hay más remedio, contraseña (déjala comentada si usas clave):
FTPS_PASSWORD=""

# Carpeta del servidor donde vive la web
FTPS_REMOTE_DIR="public_html/"

# "yes" borra en el servidor lo que ya no esté en la web nueva.
# Déjalo en "no" hasta comprobar con --dry-run que la carpeta es SOLO de la web.
FTPS_DELETE="no"